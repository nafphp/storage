{
  "name": "naf/storage",
  "description": "Provider-independent file storage with named disks and streams for NAF.",
  "type": "naf-plugin",
  "license": "MIT",
  "require": {
    "php": ">=8.3",
    "naf/framework": "^0.2"
  },
  "autoload": {
    "psr-4": {
      "Naf\\Storage\\": "src/"
    }
  },
  "autoload-dev": {
    "psr-4": {
      "Tests\\": "tests/"
    }
  },
  "scripts": {
    "test": [
      "@php vendor/bin/phpunit --colors=always",
      "@php tests/host.php"
    ]
  },
  "require-dev": {
    "phpunit/phpunit": "^11.5 || ^12.1"
  }
}
